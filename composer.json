{
    "name": "ingenerator/cloud-tasks-wrapper",
    "description": "Library for dispatching and processing Google Cloud Tasks from PHP",
    "homepage": "https://github.com/ingenerator/cloud-tasks-wrapper",
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Andrew Coulton",
            "email": "andrew@ingenerator.com"
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0 || ~8.6.0",
        "ext-bcmath": "*",
        "google/cloud-tasks": "^2.0",
        "google/gax": "^1.29.1",
        "google/protobuf": "^v5.34",
        "ingenerator/oidc-token-verifier": "^1.7",
        "ingenerator/php-utils": "^2.0 || ^3.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "ext-grpc": "*",
        "fig/log-test": "^1.1",
        "guzzlehttp/psr7": "^3.5",
        "php-cs-fixer/shim": "3.95.32",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "2.8.5"
    },
    "repositories": [
        {"type": "composer", "url": "https://php-packages.ingenerator.com"}
    ],
    "support": {
        "source": "https://github.com/ingenerator/cloud-tasks-wrapper",
        "issues": "https://github.com/ingenerator/cloud-tasks-wrapper/issues"
    },
    "autoload": {
        "psr-4": {
            "Ingenerator\\CloudTasksWrapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "test\\mock\\Ingenerator\\CloudTasksWrapper\\": "test/mock",
            "test\\unit\\Ingenerator\\CloudTasksWrapper\\": "test/unit"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "ext-bcmath": "8"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --verbose --diff",
        "cs-fix": "php-cs-fixer fix",
        "rector": "rector --dry-run",
        "rector-fix": "rector"
    }
}
