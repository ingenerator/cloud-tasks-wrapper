parameters:
    treatPhpDocTypesAsCertain: false
    level: 10
    paths:
        - src
        - test

    ignoreErrors:
      # CreateTaskOptions uses ObjectPropertyPopulator::assignHash - to refactor to named args
      -
        identifier: property.unusedType
        path: src/Client/CreateTaskOptions.php

      # Will be fixed with update to oidc-token-verifier 2.x in separate PR
      -
        message: /MockTokenVerifier/
        path: test/unit/Server/Middleware/TaskRequestAuthenticatingMiddlewareTest.php
